# Copy to .env for local work; never commit real values.
GATEWAY_HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_GRPC_ADDR=:9091
USER_GRPC_ADDR=:9092
MARKET_GRPC_ADDR=:9093
AI_GRPC_ADDR=:9094
AI_HTTP_ADDR=:8081

# Keep DSNs in Secrets; the service enforces TLS and loads the CA below.
AUTH_MYSQL_DSN=
USER_MYSQL_DSN=
MARKET_MYSQL_DSN=
MYSQL_TLS_CA_FILE=/path/to/heatwave-ca.pem
# Leave empty when the DNS name in the DSN matches the database certificate.
# Set to the certificate hostname when connecting through an NLB IP.
MYSQL_TLS_SERVER_NAME=

# Generate a random key of at least 32 bytes and provide it via a secret store.
JWT_SIGNING_KEY=
JWT_ISSUER=finsights-auth
JWT_ACCESS_TTL=15m

# RabbitMQ URL is a secret; no credentials are committed here.
RABBITMQ_URL=
RABBITMQ_EXCHANGE=finsights.events
RABBITMQ_USER_QUEUE=user.account-created

GRPC_DIAL_TIMEOUT=5s
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5

# Copy to .env for local work; never commit real values.
GATEWAY_HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_GRPC_ADDR=:9091
USER_GRPC_ADDR=:9092
MARKET_GRPC_ADDR=:9093
AI_GRPC_ADDR=:9094
AI_HTTP_ADDR=:8081
AI_SERVICE_ADDR=localhost:9094
AI_HTTP_SERVICE_ADDR=http://localhost:8081

# Keep DSNs in Secrets; the service enforces TLS and loads the CA below.
AUTH_MYSQL_DSN=
USER_MYSQL_DSN=
MARKET_MYSQL_DSN=
MARKET_DATA_MYSQL_DSN=
NEWS_MYSQL_DSN=
FUNDAMENTALS_MYSQL_DSN=
DISCLOSURES_MYSQL_DSN=
MYSQL_TLS_CA_FILE=/path/to/heatwave-ca.pem
# Leave empty when the DNS name in the DSN matches the database certificate.
# Set to the certificate hostname when connecting through an NLB IP.
MYSQL_TLS_SERVER_NAME=

# Generate a random key of at least 32 bytes and provide it via a secret store.
JWT_SIGNING_KEY=
JWT_ISSUER=finsights-auth
JWT_ACCESS_TTL=15m
GOOGLE_OAUTH_CLIENT_ID=

# RabbitMQ URL is a secret; no credentials are committed here.
RABBITMQ_URL=
RABBITMQ_EXCHANGE=finsights.events
RABBITMQ_USER_QUEUE=user.account-created

# AI output model: DeepSeek by default. For GPT, change base URL and model.
# Store provider credentials in Kubernetes Secrets or an uncommitted local .env.
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_MODEL=deepseek-flash
AI_LLM_API_KEY=
AI_LLM_TIMEOUT_SECONDS=20
AI_TURN_TIMEOUT_SECONDS=50
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_TOOL_ROUNDS=3
AI_MAX_TOOL_CALLS=5
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_TURNS=2
AI_MARKET_SERVICE_ADDR=localhost:9093
AI_USER_SERVICE_ADDR=localhost:9092

# AI chat history is stored on MySQL Node 2 in finsights_ai.
AI_MYSQL_HOST=
AI_MYSQL_PORT=3306
AI_MYSQL_DATABASE=finsights_ai
AI_MYSQL_USER=finsights_ai_app
AI_MYSQL_PASSWORD=
AI_MYSQL_TLS_CA_FILE=/path/to/mysql-node-2-ca.pem
# Set true when the certificate identity matches AI_MYSQL_HOST. The legacy OCI
# endpoint currently uses a certificate name that differs from its IP address.
AI_MYSQL_TLS_VERIFY_IDENTITY=true
AI_MYSQL_POOL_SIZE=2

# Oracle Autonomous DB stores RAG chunks/vectors. RAG and Voyage are optional.
# Mount the downloaded Autonomous Database wallet outside the repository.
AI_RAG_ENABLED=false
AI_VECTOR_DIMENSIONS=1024
AI_ORACLE_DSN=
AI_ORACLE_USER=
AI_ORACLE_PASSWORD=
AI_ORACLE_WALLET_DIR=/path/to/oracle-wallet
AI_ORACLE_WALLET_PASSWORD=
AI_VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
AI_VOYAGE_MODEL=voyage-4-lite
VOYAGE_API_KEY=

GRPC_DIAL_TIMEOUT=5s
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
